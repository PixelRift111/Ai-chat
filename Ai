local function clearChat()

	for _,child in ipairs(chat:GetChildren()) do

		if child ~= layout
			and child ~= padding then

			child:Destroy()

		end

	end

	local newEmpty = Instance.new("Frame")
	newEmpty.Size = UDim2.new(1,0,0,190)
	newEmpty.BackgroundTransparency = 1
	newEmpty.Parent = chat

	local t = Instance.new("TextLabel")
	t.Size = UDim2.new(1,-10,0,60)
	t.Position = UDim2.new(0,5,0,20)

	t.BackgroundTransparency = 1
	t.Text = "วันนี้อยากรู้เรื่องอะไร"
	t.TextColor3 = INK
	t.TextSize = 24
	t.Font = Enum.Font.Garamond
	t.TextXAlignment = Enum.TextXAlignment.Left
	t.Parent = newEmpty

	local s = Instance.new("TextLabel")
	s.Size = UDim2.new(1,-10,0,40)
	s.Position = UDim2.new(0,5,0,68)

	s.BackgroundTransparency = 1
	s.Text = "พิมพ์คำถาม หรือเลือกหัวข้อด้านล่างเพื่อเริ่มคุย"
	s.TextColor3 = MUTED
	s.TextSize = 12
	s.Font = Enum.Font.Gotham
	s.TextXAlignment = Enum.TextXAlignment.Left
	s.Parent = newEmpty

	input.Text = ""

end


local function scrollBottom()

	task.wait()

	chat.CanvasPosition = Vector2.new(
		0,
		math.max(
			0,
			chat.AbsoluteCanvasSize.Y -
			chat.AbsoluteSize.Y
		)
	)

end

--==================================================
-- ADD MESSAGE
--==================================================

local function addMessage(text,user)

	local row = Instance.new("Frame")
	row.Size = UDim2.new(1,0,0,0)
	row.AutomaticSize = Enum.AutomaticSize.Y
	row.BackgroundTransparency = 1
	row.Parent = chat

	local bubble = Instance.new("TextLabel")

	bubble.Size = UDim2.new(
		user and 0.78 or 0.84,
		0,
		0,
		0
	)

	bubble.AutomaticSize = Enum.AutomaticSize.Y

	if user then

		bubble.Position = UDim2.new(1,0,0,0)
		bubble.AnchorPoint = Vector2.new(1,0)

		bubble.BackgroundColor3 = AMBER_TINT
		bubble.TextColor3 = Color3.fromRGB(74,46,15)

	else

		bubble.Position = UDim2.new(0,0,0,0)

		bubble.BackgroundColor3 = PAPER
		bubble.TextColor3 = INK

	end

	bubble.Text = text
	bubble.TextSize = 13
	bubble.Font = Enum.Font.Gotham
	bubble.TextWrapped = true

	bubble.TextXAlignment = Enum.TextXAlignment.Left
	bubble.TextYAlignment = Enum.TextYAlignment.Top

	bubble.BorderSizePixel = 0
	bubble.Parent = row

	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0,12)
	p.PaddingRight = UDim.new(0,12)
	p.PaddingTop = UDim.new(0,9)
	p.PaddingBottom = UDim.new(0,9)
	p.Parent = bubble

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0,15)
	c.Parent = bubble

	if not user then

		local line = Instance.new("Frame")
		line.Size = UDim2.new(0,3,1,0)
		line.BackgroundColor3 = TEAL
		line.BorderSizePixel = 0
		line.Parent = bubble

		local lc = Instance.new("UICorner")
		lc.CornerRadius = UDim.new(1,0)
		lc.Parent = line

	end

	scrollBottom()

end

--==================================================
-- SEND SYSTEM
--==================================================

local busy = false

local function sendMessage()

	if busy then
		return
	end

	local text = input.Text

	if not text or text:match("^%s*$") then
		return
	end

	busy = true

	empty.Visible = false

	addMessage(text,true)

	input.Text = ""

	task.delay(1,function()

		if not gui.Parent then
			return
		end

		addMessage(
			"นี่คือคำตอบตัวอย่างครับ สามารถเชื่อมต่อ AI API ของคุณตรงส่วนนี้ได้",
			false
		)

		busy = false

	end)

end

send.MouseButton1Click:Connect(sendMessage)

